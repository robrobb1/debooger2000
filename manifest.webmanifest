{
  "id": "./",
  "name": "DEBOOGER2000",
  "short_name": "DEBOOGER",
  "description": "Personal files, project viewer and automatic code auditor.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f4f6f4",
  "theme_color": "#f4f6f4",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "text/html": [".html", ".htm"],
        "text/css": [".css"],
        "text/javascript": [".js", ".mjs", ".cjs", ".jsx"],
        "application/json": [".json"],
        "application/xml": [".xml"],
        "text/plain": [".txt", ".md", ".ts", ".tsx", ".py", ".sh", ".vbs", ".yml", ".yaml", ".env"],
        "application/zip": [".zip"],
        "application/pdf": [".pdf"],
        "image/png": [".png"],
        "image/jpeg": [".jpg", ".jpeg"],
        "image/gif": [".gif"],
        "image/webp": [".webp"],
        "image/svg+xml": [".svg"],
        "image/x-icon": [".ico"],
        "audio/mpeg": [".mp3"],
        "audio/wav": [".wav"],
        "audio/mp4": [".m4a"],
        "audio/aac": [".aac"],
        "audio/ogg": [".ogg", ".oga"],
        "video/mp4": [".mp4", ".m4v"],
        "video/quicktime": [".mov"],
        "video/webm": [".webm"],
        "video/ogg": [".ogv"]
      }
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    {
      "src": "./assets/debooger-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
